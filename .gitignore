# Project: training outputs
# Keep small artefacts (metrics.csv, evaluation_results.txt, plot PNGs).
# Exclude large checkpoints (.pt, often 500+ MB) and old/backup runs.
outputs/**/*.pt
outputs/**/optimizer_state*.pt
outputs/BACKUP_*/
